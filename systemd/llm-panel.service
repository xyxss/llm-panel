[Unit]
Description=LLM control panel + OpenAI-compatible router (web UI :8080, router :8001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liuyang
Group=liuyang
Environment=HOME=/home/liuyang
WorkingDirectory=/home/liuyang/llm-stack
ExecStart=/usr/bin/python3 /home/liuyang/llm-stack/panel/panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
